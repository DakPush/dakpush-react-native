{
  "name": "dakpush-react-native-example",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios": "xcodebuild -workspace ios/DakPushRN.xcworkspace -scheme DakPushRN -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cd android && ./gradlew assembleDebug"
  },
  "private": true,
  "devDependencies": {
    "react-native-builder-bob": "^0.44.1",
    "react-native-monorepo-config": "^0.4.0"
  }
}
